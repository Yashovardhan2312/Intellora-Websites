{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intellora-websites",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www.intellora.co.in", "custom_domain": true },
    { "pattern": "intellora.co.in", "custom_domain": true }
  ]
}
